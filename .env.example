# Copy to .env and adjust if needed. Never commit real secrets.

# PostgreSQL
POSTGRES_DB=cgi_kpi_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Demo login (created on first start when the database has no users)
BOOTSTRAP_ADMIN_USERNAME=admin1
BOOTSTRAP_ADMIN_PASSWORD=DemoAdmin1!
BOOTSTRAP_MUST_CHANGE_PASSWORD=false

# Frontend host port
FRONTEND_PORT=4200

# AI (optional — dashboard and KPIs work without an AI API key)
APP_AI_ENABLED=true
APP_AI_PROVIDER=mock
APP_AI_MODEL=
APP_AI_MASTER_KEY=docker-demo-master-key-not-for-production
# Provider-specific API key (e.g. Gemini); leave empty to keep AI features disabled
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
